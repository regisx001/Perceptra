# ==============================================================================
# Production Environment Configuration (Port 5555)
# ==============================================================================
FLASK_ENV=production
PORT=5555
PROD_PORT=5555

# Frontend Vite Proxy
VITE_API_PORT=5555
VITE_PROXY_TARGET=http://127.0.0.1:5555

# Database & Security
DATABASE_URL=sqlite:////app/instance/perceptra.db
SQLALCHEMY_TRACK_MODIFICATIONS=false
SECRET_KEY=prod-secret-key-change-in-production-at-least-32-bytes
JWT_SECRET_KEY=jwt-secret-key-change-in-production-at-least-32-bytes
STORAGE_PROTOCOL=file
STORAGE_BASE_PATH=/app/storage
FRONTEND_DIST_DIR=/app/web_dist
