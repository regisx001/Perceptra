# ==============================================================================
# Unified Perceptra Environment Configuration (Backend & Frontend)
# ==============================================================================

# Server Ports
DEV_PORT=7000
PORT=5555

# Frontend Vite Proxy Configuration
# Development default: http://127.0.0.1:7000
# Production default: http://127.0.0.1:5555
VITE_API_PORT=7000
VITE_PROXY_TARGET=http://127.0.0.1:7000

# Database
DATABASE_URL=sqlite:///app.db
SQLALCHEMY_TRACK_MODIFICATIONS=false

# Security & Authentication
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-bytes
JWT_SECRET_KEY=jwt-secret-key-change-in-production-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRES=86400

# File Storage (fsspec)
STORAGE_PROTOCOL=file
STORAGE_BASE_PATH=storage
MAX_CONTENT_LENGTH=33554432
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,bmp,tiff,gif

# Frontend Distribution Directory (SPA served by Flask in production)
FRONTEND_DIST_DIR=web/build
