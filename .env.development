# ==============================================================================
# Development Environment Configuration (Port 7000)
# ==============================================================================
FLASK_ENV=development
DEV_PORT=7000
PORT=7000

# Frontend Vite Proxy
VITE_API_PORT=7000
VITE_PROXY_TARGET=http://127.0.0.1:7000

# Database & Security
DATABASE_URL=sqlite:///app.db
SQLALCHEMY_TRACK_MODIFICATIONS=false
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-bytes
JWT_SECRET_KEY=jwt-secret-key-change-in-production-at-least-32-bytes
STORAGE_PROTOCOL=file
STORAGE_BASE_PATH=storage
